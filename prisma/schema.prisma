generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
}

model Atom {
  molecule_id Int       @db.UnsignedInt
  rack_id     Int       @db.UnsignedInt
  unit_no     Int       @db.UnsignedInt
  atom        Atom_atom
  Molecule    Molecule  @relation(fields: [molecule_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Atom-FK-molecule_id")
  Object      Object    @relation(fields: [rack_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Atom-FK-rack_id")

  @@id([molecule_id, rack_id, unit_no, atom])
  @@index([rack_id], map: "Atom-FK-rack_id")
}

model Attribute {
  id           Int             @id @default(autoincrement()) @db.UnsignedInt
  type         Attribute_type?
  name         String?         @unique(map: "name") @db.Char(64)
  AttributeMap AttributeMap[]
}

model AttributeMap {
  objtype_id     Int                  @default(1) @db.UnsignedInt
  attr_id        Int                  @default(1) @db.UnsignedInt
  chapter_id     Int?                 @db.UnsignedInt
  sticky         AttributeMap_sticky? @default(no)
  Attribute      Attribute            @relation(fields: [attr_id], references: [id], onUpdate: Restrict, map: "AttributeMap-FK-attr_id")
  Chapter        Chapter?             @relation(fields: [chapter_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "AttributeMap-FK-chapter_id")
  AttributeValue AttributeValue[]

  @@unique([objtype_id, attr_id], map: "objtype_id")
  @@index([attr_id], map: "attr_id")
  @@index([chapter_id], map: "chapter_id")
}

model AttributeValue {
  object_id    Int          @db.UnsignedInt
  object_tid   Int          @default(0) @db.UnsignedInt
  attr_id      Int          @db.UnsignedInt
  string_value String?      @db.Char(255)
  uint_value   Int?         @db.UnsignedInt
  float_value  Float?       @db.Float
  AttributeMap AttributeMap @relation(fields: [object_tid, attr_id], references: [objtype_id, attr_id], onUpdate: Restrict, map: "AttributeValue-FK-map")
  Object       Object       @relation(fields: [object_id, object_tid], references: [id, objtype_id], onDelete: Cascade, map: "AttributeValue-FK-object")

  @@id([object_id, attr_id])
  @@index([attr_id, string_value(length: 12)], map: "attr_id-string_value")
  @@index([attr_id, uint_value], map: "attr_id-uint_value")
  @@index([object_id, object_tid], map: "id-tid")
  @@index([object_tid, attr_id], map: "object_tid-attr_id")
}

model CachedPAV {
  object_id   Int         @db.UnsignedInt
  port_name   String      @db.Char(255)
  vlan_id     Int         @default(0) @db.UnsignedInt
  CachedPVM   CachedPVM   @relation(fields: [object_id, port_name], references: [object_id, port_name], onDelete: Cascade, onUpdate: Restrict, map: "CachedPAV-FK-object-port")
  VLANValidID VLANValidID @relation(fields: [vlan_id], references: [vlan_id], onUpdate: Restrict, map: "CachedPAV-FK-vlan_id")
  CachedPNV   CachedPNV?

  @@id([object_id, port_name, vlan_id])
  @@index([vlan_id], map: "vlan_id")
}

model CachedPNV {
  object_id Int       @db.UnsignedInt
  port_name String    @db.Char(255)
  vlan_id   Int       @default(0) @db.UnsignedInt
  CachedPAV CachedPAV @relation(fields: [object_id, port_name, vlan_id], references: [object_id, port_name, vlan_id], onDelete: Cascade, onUpdate: Restrict, map: "CachedPNV-FK-compound")

  @@id([object_id, port_name, vlan_id])
  @@unique([object_id, port_name], map: "port_id")
}

model CachedPVM {
  object_id    Int                 @db.UnsignedInt
  port_name    String              @db.Char(255)
  vlan_mode    CachedPVM_vlan_mode @default(access)
  CachedPAV    CachedPAV[]
  Object       Object              @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "CachedPVM-FK-object_id")
  PortVLANMode PortVLANMode?

  @@id([object_id, port_name])
}

model Chapter {
  id           Int             @id @default(autoincrement()) @db.UnsignedInt
  sticky       Chapter_sticky? @default(no)
  name         String          @unique(map: "name") @db.Char(128)
  AttributeMap AttributeMap[]
  Dictionary   Dictionary[]
}

model Config {
  varname        String                @id @db.Char(32)
  varvalue       String                @db.Text
  vartype        Config_vartype        @default(string)
  emptyok        Config_emptyok        @default(no)
  is_hidden      Config_is_hidden      @default(yes)
  is_userdefined Config_is_userdefined @default(no)
  description    String?               @db.Text
  UserConfig     UserConfig[]
}

model Dictionary {
  chapter_id  Int                     @db.UnsignedInt
  dict_key    Int                     @id @default(autoincrement()) @db.UnsignedInt
  dict_sticky Dictionary_dict_sticky? @default(no)
  dict_value  String?                 @db.Char(255)
  Chapter     Chapter                 @relation(fields: [chapter_id], references: [id], onUpdate: Restrict, map: "Dictionary-FK-chapter_id")

  @@unique([chapter_id, dict_value, dict_sticky], map: "dict_unique")
}

model EntityLink {
  id                 Int                           @id @default(autoincrement()) @db.UnsignedInt
  parent_entity_type EntityLink_parent_entity_type
  parent_entity_id   Int                           @db.UnsignedInt
  child_entity_type  EntityLink_child_entity_type
  child_entity_id    Int                           @db.UnsignedInt

  @@unique([parent_entity_type, parent_entity_id, child_entity_type, child_entity_id], map: "EntityLink-unique")
  @@index([parent_entity_type, child_entity_type, child_entity_id], map: "EntityLink-compound")
}

model File {
  id        Int        @id @default(autoincrement()) @db.UnsignedInt
  name      String     @unique(map: "name") @db.Char(255)
  type      String     @db.Char(255)
  size      Int        @db.UnsignedInt
  ctime     DateTime   @db.DateTime(0)
  mtime     DateTime   @db.DateTime(0)
  atime     DateTime   @db.DateTime(0)
  thumbnail Bytes?
  contents  Bytes
  comment   String?    @db.Text
  FileLink  FileLink[]
}

model FileLink {
  id          Int                  @id @default(autoincrement()) @db.UnsignedInt
  file_id     Int                  @db.UnsignedInt
  entity_type FileLink_entity_type @default(object)
  entity_id   Int
  File        File                 @relation(fields: [file_id], references: [id], onDelete: Cascade, map: "FileLink-File_fkey")

  @@unique([file_id, entity_type, entity_id], map: "FileLink-unique")
  @@index([file_id], map: "FileLink-file_id")
}

model IPv4Address {
  ip       Int                   @id @default(0) @db.UnsignedInt
  name     String                @default("") @db.Char(255)
  comment  String                @default("") @db.Char(255)
  reserved IPv4Address_reserved?
}

model IPv4Allocation {
  object_id Int                 @default(0) @db.UnsignedInt
  ip        Int                 @default(0) @db.UnsignedInt
  name      String              @default("") @db.Char(255)
  type      IPv4Allocation_type @default(regular)
  Object    Object              @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "IPv4Allocation-FK-object_id")

  @@id([object_id, ip])
  @@index([ip], map: "ip")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model IPv4LB {
  object_id  Int?        @db.UnsignedInt
  rspool_id  Int?        @db.UnsignedInt
  vs_id      Int?        @db.UnsignedInt
  prio       String?     @db.VarChar(255)
  vsconfig   String?     @db.Text
  rsconfig   String?     @db.Text
  Object     Object?     @relation(fields: [object_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "IPv4LB-FK-object_id")
  IPv4RSPool IPv4RSPool? @relation(fields: [rspool_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "IPv4LB-FK-rspool_id")
  IPv4VS     IPv4VS?     @relation(fields: [vs_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "IPv4LB-FK-vs_id")

  @@unique([object_id, vs_id], map: "LB-VS")
  @@index([rspool_id], map: "IPv4LB-FK-rspool_id")
  @@index([vs_id], map: "IPv4LB-FK-vs_id")
  @@ignore
}

model IPv4Log {
  id      Int      @id @default(autoincrement())
  ip      Int      @db.UnsignedInt
  date    DateTime @db.DateTime(0)
  user    String   @db.VarChar(64)
  message String   @db.Text

  @@index([ip, date], map: "ip-date")
}

model IPv4NAT {
  object_id   Int           @default(0) @db.UnsignedInt
  proto       IPv4NAT_proto @default(TCP)
  localip     Int           @default(0) @db.UnsignedInt
  localport   Int           @default(0) @db.UnsignedSmallInt
  remoteip    Int           @default(0) @db.UnsignedInt
  remoteport  Int           @default(0) @db.UnsignedSmallInt
  description String?       @db.Char(255)
  Object      Object        @relation(fields: [object_id], references: [id], onUpdate: Restrict, map: "IPv4NAT-FK-object_id")

  @@id([object_id, proto, localip, localport, remoteip, remoteport])
  @@index([localip], map: "localip")
  @@index([object_id], map: "object_id")
  @@index([remoteip], map: "remoteip")
}

model IPv4Network {
  id       Int        @id @default(autoincrement()) @db.UnsignedInt
  ip       Int        @default(0) @db.UnsignedInt
  mask     Int        @default(0) @db.UnsignedInt
  name     String?    @db.Char(255)
  comment  String?    @db.Text
  VLANIPv4 VLANIPv4[]

  @@unique([ip, mask], map: "base-len")
}

model IPv4RS {
  id         Int              @id @default(autoincrement()) @db.UnsignedInt
  inservice  IPv4RS_inservice @default(no)
  rsip       Bytes            @db.VarBinary(16)
  rsport     Int?             @db.UnsignedSmallInt
  rspool_id  Int?             @db.UnsignedInt
  rsconfig   String?          @db.Text
  comment    String?          @db.VarChar(255)
  IPv4RSPool IPv4RSPool?      @relation(fields: [rspool_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "IPv4RS-FK")

  @@unique([rspool_id, rsip, rsport], map: "pool-endpoint")
  @@index([rsip], map: "rsip")
}

model IPv4RSPool {
  id             Int              @id @default(autoincrement()) @db.UnsignedInt
  name           String?          @db.Char(255)
  vsconfig       String?          @db.Text
  rsconfig       String?          @db.Text
  IPv4LB         IPv4LB[]         @ignore
  IPv4RS         IPv4RS[]
  VSEnabledIPs   VSEnabledIPs[]
  VSEnabledPorts VSEnabledPorts[]
}

model IPv4VS {
  id       Int          @id @default(autoincrement()) @db.UnsignedInt
  vip      Bytes        @db.VarBinary(16)
  vport    Int?         @db.UnsignedSmallInt
  proto    IPv4VS_proto @default(TCP)
  name     String?      @db.Char(255)
  vsconfig String?      @db.Text
  rsconfig String?      @db.Text
  IPv4LB   IPv4LB[]     @ignore

  @@index([vip], map: "vip")
}

model IPv6Address {
  ip       Bytes                 @id @db.Binary(16)
  name     String                @default("") @db.Char(255)
  comment  String                @default("") @db.Char(255)
  reserved IPv6Address_reserved?
}

model IPv6Allocation {
  object_id Int                 @default(0) @db.UnsignedInt
  ip        Bytes               @db.Binary(16)
  name      String              @default("") @db.Char(255)
  type      IPv6Allocation_type @default(regular)
  Object    Object              @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "IPv6Allocation-FK-object_id")

  @@id([object_id, ip])
  @@index([ip], map: "ip")
}

model IPv6Log {
  id      Int      @id @default(autoincrement())
  ip      Bytes    @db.Binary(16)
  date    DateTime @db.DateTime(0)
  user    String   @db.VarChar(64)
  message String   @db.Text

  @@index([ip, date], map: "ip-date")
}

model IPv6Network {
  id       Int        @id @default(autoincrement()) @db.UnsignedInt
  ip       Bytes      @db.Binary(16)
  mask     Int        @db.UnsignedInt
  last_ip  Bytes      @db.Binary(16)
  name     String?    @db.Char(255)
  comment  String?    @db.Text
  VLANIPv6 VLANIPv6[]

  @@unique([ip, mask], map: "ip")
}

model LDAPCache {
  presented_username String    @unique(map: "presented_username") @db.Char(64)
  successful_hash    String    @db.Char(40)
  first_success      DateTime  @default(now()) @db.Timestamp(0)
  last_retry         DateTime? @db.Timestamp(0)
  displayed_name     String?   @db.Char(128)
  memberof           String?   @db.Text

  @@index([presented_username, successful_hash], map: "scanidx")
}

model Link {
  porta                 Int     @unique(map: "porta") @default(0) @db.UnsignedInt
  portb                 Int     @unique(map: "portb") @default(0) @db.UnsignedInt
  cable                 String? @db.Char(64)
  Port_Link_portaToPort Port    @relation("Link_portaToPort", fields: [porta], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Link-FK-a")
  Port_Link_portbToPort Port    @relation("Link_portbToPort", fields: [portb], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Link-FK-b")

  @@id([porta, portb])
}

model Molecule {
  id                                                      Int             @id @default(autoincrement()) @db.UnsignedInt
  Atom                                                    Atom[]
  MountOperation_MountOperation_new_molecule_idToMolecule MountOperation? @relation("MountOperation_new_molecule_idToMolecule")
  MountOperation_MountOperation_old_molecule_idToMolecule MountOperation? @relation("MountOperation_old_molecule_idToMolecule")
}

model MountOperation {
  id                                                Int       @id @default(autoincrement()) @db.UnsignedInt
  object_id                                         Int       @default(0) @db.UnsignedInt
  ctime                                             DateTime  @default(now()) @db.Timestamp(0)
  user_name                                         String?   @db.Char(64)
  old_molecule_id                                   Int?      @unique(map: "old_molecule_id") @db.UnsignedInt
  new_molecule_id                                   Int?      @unique(map: "new_molecule_id") @db.UnsignedInt
  comment                                           String?   @db.Text
  Molecule_MountOperation_new_molecule_idToMolecule Molecule? @relation("MountOperation_new_molecule_idToMolecule", fields: [new_molecule_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "MountOperation-FK-new_molecule_id")
  Object                                            Object    @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "MountOperation-FK-object_id")
  Molecule_MountOperation_old_molecule_idToMolecule Molecule? @relation("MountOperation_old_molecule_idToMolecule", fields: [old_molecule_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "MountOperation-FK-old_molecule_id")

  @@index([object_id], map: "object_id")
}

model Object {
  id                                    Int                 @id @default(autoincrement()) @db.UnsignedInt
  name                                  String?             @db.Char(255)
  label                                 String?             @db.Char(255)
  objtype_id                            Int                 @default(1) @db.UnsignedInt
  asset_no                              String?             @unique(map: "asset_no") @db.Char(64)
  has_problems                          Object_has_problems @default(no)
  comment                               String?             @db.Text
  Atom                                  Atom[]
  AttributeValue                        AttributeValue[]
  CachedPVM                             CachedPVM[]
  IPv4Allocation                        IPv4Allocation[]
  IPv4LB                                IPv4LB[]            @ignore
  IPv4NAT                               IPv4NAT[]
  IPv6Allocation                        IPv6Allocation[]
  MountOperation                        MountOperation[]
  ObjectHistory                         ObjectHistory[]
  ObjectLog                             ObjectLog[]
  Port                                  Port[]
  RackSpace_RackSpace_object_idToObject RackSpace[]         @relation("RackSpace_object_idToObject")
  RackSpace_RackSpace_rack_idToObject   RackSpace[]         @relation("RackSpace_rack_idToObject")
  RackThumbnail                         RackThumbnail?
  VLANSwitch                            VLANSwitch?
  VSEnabledIPs                          VSEnabledIPs[]
  VSEnabledPorts                        VSEnabledPorts[]

  // `id` is already the primary key, so this pair is necessarily unique and
  // can safely be used by Prisma for RackTables' composite foreign key.
  @@unique([id, objtype_id])
  @@index([id, objtype_id], map: "id-tid")
  @@index([objtype_id, id], map: "type_id")
}

model ObjectHistory {
  event_id     Int                        @id @default(autoincrement()) @db.UnsignedInt
  id           Int?                       @db.UnsignedInt
  name         String?                    @db.Char(255)
  label        String?                    @db.Char(255)
  objtype_id   Int?                       @db.UnsignedInt
  asset_no     String?                    @db.Char(64)
  has_problems ObjectHistory_has_problems @default(no)
  comment      String?                    @db.Text
  ctime        DateTime                   @default(now()) @db.Timestamp(0)
  user_name    String?                    @db.Char(64)
  Object       Object?                    @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ObjectHistory-FK-object_id")

  @@index([id], map: "id")
}

model ObjectLog {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  object_id Int      @db.UnsignedInt
  user      String   @db.Char(64)
  date      DateTime @db.DateTime(0)
  content   String   @db.Text
  Object    Object   @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "ObjectLog-FK-object_id")

  @@index([date], map: "date")
  @@index([object_id], map: "object_id")
}

model ObjectParentCompat {
  parent_objtype_id Int @db.UnsignedInt
  child_objtype_id  Int @db.UnsignedInt

  @@unique([parent_objtype_id, child_objtype_id], map: "parent_child")
}

model PatchCableConnector {
  id                        Int                         @id @default(autoincrement()) @db.UnsignedInt
  origin                    PatchCableConnector_origin  @default(custom)
  connector                 String                      @db.Char(32)
  PatchCableConnectorCompat PatchCableConnectorCompat[]

  @@unique([connector, origin], map: "connector_per_origin")
}

model PatchCableConnectorCompat {
  pctype_id                                                                       Int                 @db.UnsignedInt
  connector_id                                                                    Int                 @db.UnsignedInt
  PatchCableConnector                                                             PatchCableConnector @relation(fields: [connector_id], references: [id], onUpdate: Restrict, map: "PatchCableConnectorCompat-FK-connector_id")
  PatchCableType                                                                  PatchCableType      @relation(fields: [pctype_id], references: [id], onUpdate: Restrict, map: "PatchCableConnectorCompat-FK-pctype_id")
  PatchCableHeap_PatchCableHeap_pctype_id_end1_conn_idToPatchCableConnectorCompat PatchCableHeap[]    @relation("PatchCableHeap_pctype_id_end1_conn_idToPatchCableConnectorCompat")
  PatchCableHeap_PatchCableHeap_pctype_id_end2_conn_idToPatchCableConnectorCompat PatchCableHeap[]    @relation("PatchCableHeap_pctype_id_end2_conn_idToPatchCableConnectorCompat")

  @@id([pctype_id, connector_id])
  @@index([connector_id], map: "connector_id")
}

model PatchCableHeap {
  id                                                                                         Int                       @id @default(autoincrement()) @db.UnsignedInt
  pctype_id                                                                                  Int                       @db.UnsignedInt
  end1_conn_id                                                                               Int                       @db.UnsignedInt
  end2_conn_id                                                                               Int                       @db.UnsignedInt
  amount                                                                                     Int                       @default(0) @db.UnsignedSmallInt
  length                                                                                     Decimal                   @default(1.00) @db.Decimal(5, 2)
  description                                                                                String?                   @db.Char(255)
  PatchCableConnectorCompat_PatchCableHeap_pctype_id_end1_conn_idToPatchCableConnectorCompat PatchCableConnectorCompat @relation("PatchCableHeap_pctype_id_end1_conn_idToPatchCableConnectorCompat", fields: [pctype_id, end1_conn_id], references: [pctype_id, connector_id], onUpdate: Restrict, map: "PatchCableHeap-FK-compat1")
  PatchCableConnectorCompat_PatchCableHeap_pctype_id_end2_conn_idToPatchCableConnectorCompat PatchCableConnectorCompat @relation("PatchCableHeap_pctype_id_end2_conn_idToPatchCableConnectorCompat", fields: [pctype_id, end2_conn_id], references: [pctype_id, connector_id], onUpdate: Restrict, map: "PatchCableHeap-FK-compat2")
  PatchCableHeapLog                                                                          PatchCableHeapLog[]

  @@index([pctype_id, end1_conn_id], map: "compat1")
  @@index([pctype_id, end2_conn_id], map: "compat2")
}

model PatchCableHeapLog {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  heap_id        Int            @db.UnsignedInt
  date           DateTime       @db.DateTime(0)
  user           String         @db.Char(64)
  message        String         @db.Char(255)
  PatchCableHeap PatchCableHeap @relation(fields: [heap_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "PatchCableHeapLog-FK-heap_id")

  @@index([heap_id, date], map: "heap_id-date")
}

model PatchCableOIFCompat {
  pctype_id          Int                @db.UnsignedInt
  oif_id             Int                @db.UnsignedInt
  PortOuterInterface PortOuterInterface @relation(fields: [oif_id], references: [id], onUpdate: Restrict, map: "PatchCableOIFCompat-FK-oif_id")
  PatchCableType     PatchCableType     @relation(fields: [pctype_id], references: [id], onUpdate: Restrict, map: "PatchCableOIFCompat-FK-pctype_id")

  @@id([pctype_id, oif_id])
  @@index([oif_id], map: "oif_id")
}

model PatchCableType {
  id                        Int                         @id @default(autoincrement()) @db.UnsignedInt
  origin                    PatchCableType_origin       @default(custom)
  pctype                    String                      @db.Char(64)
  PatchCableConnectorCompat PatchCableConnectorCompat[]
  PatchCableOIFCompat       PatchCableOIFCompat[]

  @@unique([pctype, origin], map: "pctype_per_origin")
}

model Plugin {
  name     String       @id @db.Char(255)
  longname String       @db.Char(255)
  version  String       @db.Char(64)
  home_url String       @db.Char(255)
  state    Plugin_state @default(disabled)
}

model Port {
  id                    Int                 @id @default(autoincrement()) @db.UnsignedInt
  object_id             Int                 @default(0) @db.UnsignedInt
  name                  String              @default("") @db.Char(255)
  iif_id                Int                 @db.UnsignedInt
  type                  Int                 @default(0) @db.UnsignedInt
  l2address             String?             @db.Char(64)
  reservation_comment   String?             @db.Char(255)
  label                 String?             @db.Char(255)
  Link_Link_portaToPort Link?               @relation("Link_portaToPort")
  Link_Link_portbToPort Link?               @relation("Link_portbToPort")
  PortInterfaceCompat   PortInterfaceCompat @relation(fields: [iif_id, type], references: [iif_id, oif_id], onUpdate: Restrict, map: "Port-FK-iif-oif")
  Object                Object              @relation(fields: [object_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "Port-FK-object_id")
  PortLog               PortLog[]

  @@unique([object_id, iif_id, type, name], map: "object_iif_oif_name")
  @@index([iif_id, type], map: "Port-FK-iif-oif")
  @@index([reservation_comment], map: "comment")
  @@index([l2address], map: "l2address")
  @@index([type], map: "type")
}

model PortAllowedVLAN {
  object_id      Int             @db.UnsignedInt
  port_name      String          @db.Char(255)
  vlan_id        Int             @default(0) @db.UnsignedInt
  PortVLANMode   PortVLANMode    @relation(fields: [object_id, port_name], references: [object_id, port_name], onDelete: Cascade, onUpdate: Restrict, map: "PortAllowedVLAN-FK-object-port")
  VLANValidID    VLANValidID     @relation(fields: [vlan_id], references: [vlan_id], onUpdate: Restrict, map: "PortAllowedVLAN-FK-vlan_id")
  PortNativeVLAN PortNativeVLAN?

